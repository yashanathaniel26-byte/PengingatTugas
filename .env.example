# Calendar > Export calendar > Get calendar URL (salin link .ics-nya)
ICAL_URL=https://lms.telkomuniversity.ac.id/calendar/export_execute.php?userid=XXX&authtoken=XXX&preset_what=all&preset_time=custom
# Berapa menit data di-cache (jangan terlalu sering ke LMS)
CACHE_MINUTES=30

# Telegram Bot Integration (Dapat juga disetel lewat menu Pengaturan Web)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# WhatsApp Gateway (Fonnte)
FONNTE_TOKEN=r1D5UfhNuNSigZz1jWZE
WHATSAPP_TARGET_PHONE=6281234567890

# Secret key untuk mengamankan Vercel Crons (/api/telegram/check-alerts)
CRON_SECRET=rahasia-cron-kalian-disini
